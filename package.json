{
  "name": "spritegen",
  "productName": "SpriteGen",
  "version": "0.1.0",
  "description": "Desktop app that generates pixel-art sprites from text prompts at exact native sizes (8x8 to 512x512).",
  "author": "SpriteGen contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c playwright.config.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:preview": "vite preview --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:apk": "npm run mobile:sync && cd mobile/android && ./gradlew assembleDebug",
    "mobile:icons": "node scripts/make-icon.mjs --mobile",
    "test:mobile-e2e": "npm run mobile:build && playwright test -c playwright.mobile.config.ts"
  },
  "dependencies": {
    "fast-png": "8.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.10.2",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "pngjs": "7.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "zustand": "5.0.8"
  }
}
